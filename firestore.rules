rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Tasks collection ────────────────────────────────────
    match /tasks/{taskId} {

      // Anyone can read tasks (public board)
      allow read: if true;

      // Validate on create
      allow create: if
        request.resource.data.keys().hasAll(['title','description','status','priority','assignee','tags','createdAt','updatedAt']) &&

        // Title: non-empty string, max 80 chars, no HTML
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 80 &&

        // Description: string, max 500 chars
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 500 &&

        // Status: valid enum
        request.resource.data.status in ['todo', 'inprogress', 'review', 'done'] &&

        // Priority: valid enum
        request.resource.data.priority in ['low', 'medium', 'high', 'urgent'] &&

        // Assignee: string, max 40 chars
        request.resource.data.assignee is string &&
        request.resource.data.assignee.size() <= 40 &&

        // Tags: list, max 5 items
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 5 &&

        // Timestamps: numbers
        request.resource.data.createdAt is number &&
        request.resource.data.updatedAt is number;

      // Validate on update — same field rules, createdAt immutable
      allow update: if
        request.resource.data.keys().hasAll(['title','description','status','priority','assignee','tags','updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 500 &&
        request.resource.data.status in ['todo', 'inprogress', 'review', 'done'] &&
        request.resource.data.priority in ['low', 'medium', 'high', 'urgent'] &&
        request.resource.data.assignee is string &&
        request.resource.data.assignee.size() <= 40 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 5 &&
        request.resource.data.updatedAt is number;

      // Allow deletion
      allow delete: if true;
    }
  }
}
